# Ignore everything at the root by default
/*
# ...except what we submit
!/autodrive_devkit/
!/scripts/
!/README.md
!/PLAN.md
!/TUNING.md
!/.gitignore

# Never commit build artifacts or junk
build/
install/
log/
__pycache__/
*.pyc
.DS_Store
*.zip
*.app
scripts/bridge.log
# tuning artefacts
scripts/*.log
scripts/*.npz
scripts/*.png
